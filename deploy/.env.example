# Image immuable publiée dans GHCR par le workflow de déploiement.
COFOUND_API_IMAGE=ghcr.io/yonniverse/cofound-api:latest
COFOUND_BACKUP_IMAGE=ghcr.io/yonniverse/cofound-backup:latest

# Domaine public utilisé par Caddy pour le certificat TLS automatique.
COFOUND_DOMAIN=api.example.mg

# PostgreSQL managé, avec SSL imposé par le fournisseur.
DATABASE_URL=postgresql://user:password@host:5432/cofound?sslmode=require

# Secret aléatoire long, conservé uniquement sur le serveur.
JWT_SECRET=replace-with-a-random-64-byte-secret

# Origines autorisées si le CORS est activé dans l’API.
CORS_ORIGIN=https://app.example.mg

# Variables réservées aux tickets R2/email/observabilité suivants.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_ENCRYPTION_KEY=replace-with-a-different-random-64-byte-secret
BACKUP_PREFIX=postgresql
RESTORE_DATABASE_URL=postgresql://restore_user:password@restore-host:5432/cofound_restore?sslmode=require
SENTRY_DSN=
