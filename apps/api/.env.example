# Configuration locale de l’API CoFound.
# Copiez ce fichier vers apps/api/.env, puis remplacez tous les placeholders.
# Ne committez jamais apps/api/.env.

# ─────────────────────────────────────────────────────────────────────────────
# Base de données — obligatoire
# ─────────────────────────────────────────────────────────────────────────────
# URL PostgreSQL Neon complète, avec sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# ─────────────────────────────────────────────────────────────────────────────
# Application — obligatoire
# ─────────────────────────────────────────────────────────────────────────────
# En production, utilisez une valeur longue, aléatoire et conservée dans un
# gestionnaire de secrets. Cette valeur locale est uniquement destinée au dev.
JWT_SECRET=replace-with-a-local-development-secret
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# CORS et URLs — facultatif en local
# ─────────────────────────────────────────────────────────────────────────────
# Plusieurs origines peuvent être séparées par des virgules.
# CORS_ORIGIN=http://localhost:5173
# APP_URL=http://localhost:5173
# WEB_APP_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Observabilité — facultatif en local
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary — nécessaire uniquement pour les justificatifs d’organisation
# ─────────────────────────────────────────────────────────────────────────────
# Ne jamais exposer ces valeurs dans l’application frontend.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_PRESET=cofound-organization-documents
CLOUDINARY_FOLDER=cofound/organization-requests

# ─────────────────────────────────────────────────────────────────────────────
# Seed automatique — désactivé par défaut
# ─────────────────────────────────────────────────────────────────────────────
# Utiliser uniquement en développement et jamais en production.
# SEED_ACCOUNTS_ON_START=false
# SEED_ACCOUNTS_MODE=development
# SEED_ACCOUNTS_JSON=[{"email":"...","password":"...","platformRole":"STAFF","staffRole":"SUPER_ADMIN","locale":"fr"}]
