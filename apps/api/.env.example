# Copier vers apps/api/.env puis remplacer les placeholders par les valeurs de Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Requis en production ; une valeur locale de développement suffit ici.
JWT_SECRET=replace-with-a-local-development-secret
NODE_ENV=development
PORT=3000

# Observabilité facultative en local.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug
